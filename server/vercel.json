{
  "version": 2,
  "installCommand": "cd .. && pnpm install --frozen-lockfile --ignore-scripts",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": { "includeFiles": "public/**" }
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
